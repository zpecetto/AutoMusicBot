    {
      "parameters": {
        "jsCode": "// yt-dlp reports the final path as JSON after conversion or reuse of an existing MP3.\nreturn $input.all().map((item, index) => {\n  const exitCode = Number(item.json.code ?? item.json.exitCode ?? 0);\n  if (exitCode !== 0) throw new Error(`Audio download failed with exit code ${exitCode}.`);\n  const lines = String(item.json.stdout ?? '').split(/\\r?\\n/);\n  const marker = lines.filter(line => line.startsWith('N8N_FILE:')).at(-1);\n  if (!marker) throw new Error('The downloader did not return a final audio path.');\n  let hostPath;\n  try { hostPath = JSON.parse(marker.slice('N8N_FILE:'.length)); }\n  catch { throw new Error('The downloader returned an invalid JSON path.'); }\n  if (typeof hostPath !== 'string') throw new Error('The audio path must be a string.');\n  const filename = hostPath.split('/').at(-1);\n  if (!filename || !/\\.mp3$/i.test(filename)) throw new Error('The final audio file is not an MP3.');\n  return {json: {file_path: `/home/node/.n8n-files/${filename}`}, pairedItem: {item:index}};\n});"
      },
